# .env.example — Copie para .env e preencha
# ==========================================

# --- Build / Registry ---
REGISTRY=          # Deixe vazio para build local; ex: registry.empresa.local
TAG=latest

# --- Django ---
DEBUG=0
SECRET_KEY=gere-com: python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=helpdesk.empresa.local,192.168.1.50,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://helpdesk.empresa.local,http://localhost,http://127.0.0.1

# --- Database ---
DB_USER=helpdesk
DB_PASSWORD=senha_forte_aqui_troque_em_producao
# DB_HOST=postgres (fixo no compose)
# DB_NAME=helpdesk (fixo no compose)

# --- Redis ---
# REDIS_URL=redis://redis:6379/0 (fixo no compose)

# --- LDAP (valores iniciais; configure via Admin depois) ---
LDAP_URI=ldap://samba4.interno:389
LDAP_BIND_DN=cn=helpdesk,ou=services,dc=empresa,dc=local
LDAP_BIND_PASSWORD=senha_do_service_account

# --- Email (opcional no 1º deploy) ---
# SMTP_HOST=smtp.empresa.local
# SMTP_PORT=587
# SMTP_USER=helpdesk@empresa.local
# SMTP_PASSWORD=senha_smtp
# SMTP_FROM=Helpdesk <helpdesk@empresa.local>
# SMTP_USE_TLS=True
# SMTP_USE_SSL=False